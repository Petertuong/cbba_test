# RViz settings for the CBBA demo: a grid, the /cbba/markers topic, and a camera
# looking down at the scenario area (x 0..1000, y 0..800).
Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Enabled: true
  Name: root
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 30
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid (100 per cell)
      Enabled: true
      Value: true
      Cell Size: 100
      Plane Cell Count: 14
      Color: 100; 100; 100
      Offset:
        X: 500
        Y: 400
        Z: 0
    - Class: rviz_default_plugins/MarkerArray
      Name: CBBA
      Enabled: true
      Value: true
      Topic:
        Value: /cbba/markers
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Current View
      Target Frame: <Fixed Frame>
      Value: Orbit (rviz)
      Distance: 1700
      Focal Point:
        X: 500
        Y: 400
        Z: 0
      Pitch: 1.1
      Yaw: 4.71
